---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  image?: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = site.name,
  description = site.description,
  canonicalPath = Astro.url.pathname,
  image = '/assets/images/og-default.jpg',
  schema
} = Astro.props;
const pageTitle = title === site.name ? title : `${title} | ${site.shortName}`;
const canonical = new URL(canonicalPath, site.url).toString();
const imageUrl = new URL(image, site.url).toString();
---
<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#f47a00">
    <meta name="description" content={description}>
    <meta name="robots" content="index, follow, max-image-preview:large">
    <title>{pageTitle}</title>
    <link rel="canonical" href={canonical}>
    <link rel="icon" href="/assets/favicon.png" type="image/png">
    <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png">
    <link rel="manifest" href="/site.webmanifest">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content={site.name}>
    <meta property="og:title" content={pageTitle}>
    <meta property="og:description" content={description}>
    <meta property="og:url" content={canonical}>
    <meta property="og:image" content={imageUrl}>
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={pageTitle}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image" content={imageUrl}>
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)}></script>}
  </head>
  <body>
    <Header />
    <div class="page-shell">
      <main><slot /></main>
      <Footer />
    </div>
  </body>
</html>
