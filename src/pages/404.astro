---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found" description="That page has drifted out of bounds.">
  <section class="not-found panel">
    <p class="eyebrow">404 · Out on the full</p>
    <h1>This page has missed everything.</h1>
    <p class="intro">Unlike the Giants, the website cannot play on at all costs from here.</p>
    <a class="button button-primary" href="/">Return home</a>
  </section>
</BaseLayout>
