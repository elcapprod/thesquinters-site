---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SocialGrid from '../../components/SocialGrid.astro';
import { episodes, spotifyEmbedUrl, type Episode } from '../../data/episodes';
import { site } from '../../data/site';

export function getStaticPaths() {
  return episodes.map(episode => ({ params: { slug: episode.slug }, props: { episode } }));
}

interface Props { episode: Episode; }
const { episode } = Astro.props;
const index = episodes.findIndex(item => item.slug === episode.slug);
const newer = index > 0 ? episodes[index - 1] : undefined;
const older = index < episodes.length - 1 ? episodes[index + 1] : undefined;
const episodeUrl = `${site.url}/episodes/${episode.slug}/`;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'PodcastEpisode',
  name: episode.title,
  url: episodeUrl,
  description: episode.summary,
  episodeNumber: episode.episodeNumber,
  datePublished: episode.published,
  associatedMedia: [
    { '@type': 'MediaObject', contentUrl: episode.spotifyUrl },
    { '@type': 'MediaObject', contentUrl: episode.appleUrl }
  ],
  partOfSeries: { '@type': 'PodcastSeries', name: site.name, url: site.url }
};
---
<BaseLayout title={episode.title} description={episode.summary} canonicalPath={`/episodes/${episode.slug}/`} schema={schema}>
  <article class="episode-page">
    <header class="episode-page-hero panel">
      <div class="episode-meta">
        <span>Episode {episode.episodeNumber}</span>
        <span>2026 · Round {episode.round}</span>
        {episode.publishedLabel && <time datetime={episode.published}>{episode.publishedLabel}</time>}
      </div>
      <h1>{episode.title}</h1>
      <p class="intro">{episode.summary}</p>
      <div class="button-row">
        <a class="button button-primary" href={episode.spotifyUrl} target="_blank" rel="noopener noreferrer">Listen on Spotify ↗</a>
        <a class="button button-secondary" href={episode.appleUrl} target="_blank" rel="noopener noreferrer">Listen on Apple ↗</a>
      </div>
    </header>

    <div class="episode-content-grid section-space">
      <section class="episode-copy panel" aria-label="Episode description">
        {episode.body.map((paragraph, idx) => idx === episode.body.length - 1 ? <p class="closing-line"><strong>{paragraph}</strong></p> : <p>{paragraph}</p>)}
      </section>
      <aside class="episode-sidebar">
        <div class="player-panel panel">
          <iframe src={spotifyEmbedUrl(episode.spotifyUrl)} title={`Listen to ${episode.title} on Spotify`} width="100%" height="352" frameborder="0" allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture" loading="lazy"></iframe>
        </div>
        <div class="contact-card panel">
          <p class="section-kicker">Speculate with us</p>
          <h2>Got something to add?</h2>
          <p>Email the pod, comment on Spotify or message us on X. Reviews and ratings are always welcome.</p>
          <a class="text-link" href="mailto:thesquinterspodcast@gmail.com">thesquinterspodcast@gmail.com →</a>
        </div>
      </aside>
    </div>

    <nav class="episode-pagination" aria-label="Episode navigation">
      <div>{newer && <><small>Newer episode</small><a href={`/episodes/${newer.slug}/`}>← Episode {newer.episodeNumber}</a></>}</div>
      <a class="archive-link" href="/episodes/">All episodes</a>
      <div class="pagination-right">{older && <><small>Older episode</small><a href={`/episodes/${older.slug}/`}>Episode {older.episodeNumber} →</a></>}</div>
    </nav>

    <section class="links-section compact-links" aria-labelledby="find-us-title">
      <div class="section-heading"><div><p class="section-kicker">Keep listening</p><h2 id="find-us-title">Find The Squinters everywhere.</h2></div></div>
      <SocialGrid compact={true} />
    </section>
  </article>
</BaseLayout>
