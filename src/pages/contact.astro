---
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialGrid from '../components/SocialGrid.astro';
import { site } from '../data/site';
---
<BaseLayout title="Contact" description="Contact Never Surrender by The Squinters, suggest a song, nominate a Hairloss journey or find the podcast on every platform.">
  <header class="page-hero">
    <p class="eyebrow">Speculate with us—or to us</p>
    <h1>Contact the pod.<br><span>We may even respond.</span></h1>
    <p class="intro">Send opinions, corrections, listener contributions, Song of the Week suggestions, Hairloss nominations or material evidence that Ragnar’s Maths is flawed.</p>
  </header>

  <section class="contact-hero panel section-space">
    <div>
      <p class="section-kicker">The direct line</p>
      <h2>Email The Squinters</h2>
      <p>The most reliable way to get something in front of the pod.</p>
    </div>
    <a class="button button-primary" href={`mailto:${site.email}`}>{site.email}</a>
  </section>

  <section class="section-space" aria-labelledby="contribute-title">
    <div class="section-heading"><div><p class="section-kicker">Join the chaos</p><h2 id="contribute-title">What to send us.</h2></div><p>The more specific and Giants-related, the better.</p></div>
    <div class="reason-grid">
      <article class="reason-card panel"><span>01</span><h3>Footy opinions</h3><p>Selections, structure, tactics, player form, media noise and giant issues of the week.</p></article>
      <article class="reason-card panel"><span>02</span><h3>Segment material</h3><p>Rag’s Bake targets, Hairloss nominations, quiz questions and songs that capture the week.</p></article>
      <article class="reason-card panel"><span>03</span><h3>Listener stories</h3><p>Matchday tales, travel, banners, supporter culture and moments from inside the Orange Army.</p></article>
    </div>
  </section>

  <section class="links-section" aria-labelledby="platforms-title">
    <div class="section-heading"><div><p class="section-kicker">Every platform</p><h2 id="platforms-title">Listen. Follow. Message.</h2></div><p>Comment on Spotify, message us on X or find the platform you actually use.</p></div>
    <SocialGrid />
  </section>

  <section class="support-panel panel section-space">
    <div><p class="section-kicker">Support</p><h2>Buy the pod a coffee.</h2><p>Contributions help cover the website, equipment and the steadily expanding administrative burden of being original.</p></div>
    <a class="button button-primary" href={site.supportUrl} target="_blank" rel="noopener noreferrer">Support The Squinters ↗</a>
  </section>
</BaseLayout>
