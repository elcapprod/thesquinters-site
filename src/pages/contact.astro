---
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialGrid from '../components/SocialGrid.astro';
import { site } from '../data/site';
---
<BaseLayout title="Contact" description="Contact Never Surrender by The Squinters, suggest a song, nominate a Hairloss journey or find the podcast on every platform.">
  <header class="page-hero">
    <p class="eyebrow">Speculate with us—or to us</p>
    <h1>Contact the pod.<br><span>Ride the orange tsunami with us.</span></h1>
    <p class="intro">Send opinions, suggestions, corrections, contributions, Hairloss nominations, or mathematical workings for Rag's Maths.</p>
  </header>

  <section class="contact-hero panel section-space">
    <div>
      <p class="section-kicker">The direct line</p>
      <h2>Email The Squinters</h2>
      <p>The most reliable way to get something in front of the pod.</p>
    </div>
    <a class="button button-primary" href={`mailto:${site.email}`}>{site.email}</a>
  </section>

  <section class="section-space" aria-labelledby="contribute-title">
    <div class="section-heading"><div><p class="section-kicker">Join the chaos</p><h2 id="contribute-title">What to send us.</h2></div><p>All things related to the GWS Giants are welcome in the Squinters inbox.</p></div>
    <div class="reason-grid">
      <article class="general-text-card panel"><span>01</span><h3>Footy opinions</h3><p>Selections, structure, tactics, player form, media noise and giant issues of the week.</p></article>
      <article class="general-text-card panel"><span>02</span><h3>Segment material</h3><p>Rag’s Bake targets, Hairloss nominations, quiz questions and songs that capture the week.</p></article>
      <article class="general-text-card panel"><span>03</span><h3>Listener stories</h3><p>Matchday tales, travel, banners, supporter culture and moments from inside the Orange Army.</p></article>
    </div>
  </section>

  <section class="photo-callout panel section-space" aria-labelledby="photo-callout-title">
    <figure class="photo-callout-image-wrap">
      <img
        class="photo-callout-image"
        src="/assets/images/giants-fans-at-bulldogs-elim-final-2019_portrait.jpg"
        alt="Giants supporters at the 2019 elimination final against the Western Bulldogs"
        loading="lazy"
      >
    </figure>

    <div class="photo-callout-copy">
      <p class="section-kicker">Orange Army request</p>
      <h2 id="photo-callout-title">Send us your Giants photos.</h2>
      <p>We’re rebuilding thesquinters.com and want it to look like <strong>our club and our supporter base</strong> — not a collection of generic footy photos.</p>
      <p>Games, players, finals, marches to the G, iconic wins, miserable losses, snow games, scarves, flags, questionable costumes and whatever else you’ve captured along the way — we’d love to see it.</p>
      <div class="photo-email-cta" aria-label="Email address for Orange Army photo submissions">
        <strong>Send us your photos</strong>
        <span>Email them to</span>
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </div>
    </div>
  </section>

  <section class="links-section" aria-labelledby="platforms-title">
    <div class="section-heading"><div><p class="section-kicker">Every platform</p><h2 id="platforms-title">Listen. Follow. Message.</h2></div><p>Comment on Spotify, message us on X or find the platform you actually use.</p></div>
    <SocialGrid />
  </section>

  <section class="support-panel panel section-space">
    <div><p class="section-kicker">Support</p><h2>Buy the pod a coffee.</h2><p>Contributions help cover the website, equipment and the steadily expanding administrative burden of being original.</p></div>
    <a class="button button-primary" href={site.supportUrl} target="_blank" rel="noopener noreferrer">Support The Squinters ↗</a>
  </section>
</BaseLayout>
