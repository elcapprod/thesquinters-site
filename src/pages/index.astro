---
import BaseLayout from '../layouts/BaseLayout.astro';
import EpisodeCard from '../components/EpisodeCard.astro';
import HostCard from '../components/HostCard.astro';
import RatingStrip from '../components/RatingStrip.astro';
import SocialGrid from '../components/SocialGrid.astro';
import { episodes, spotifyEmbedUrl } from '../data/episodes';
import { hosts } from '../data/hosts';
import { site, socials } from '../data/site';

const latest = episodes[0];
const podcastSchema = {
  '@context': 'https://schema.org',
  '@type': 'PodcastSeries',
  name: site.name,
  url: site.url,
  description: site.description,
  image: `${site.url}/assets/squinters-logo.png`,
  sameAs: socials.filter(item => !item.internal).map(item => item.url),
  author: { '@type': 'Organization', name: 'The Squinters' }
};
---
<BaseLayout schema={podcastSchema}>
  <section class="hero home-hero" aria-labelledby="page-title">
    <div class="hero-copy">
      	<p class="eyebrow">The <s>only</s> original GWS Giants podcast by Giants fans</p>
		<h1 id="page-title">Never Surrender.<br>
		<span>By The Squinters.</span></h1>
		<p class="intro">Every week, after every Giants match, The Squinters biasedly review the game, preview the next one, speculate on the giant issues of the week and impartially discuss anything else that biasedly occurs to them.</p>
    <div class="status">
      <span aria-hidden="true"></span> Unauthorised. Unfiltered. Uninformed.
    </div>
      <div class="button-row">
        <a class="button button-primary" href={`/episodes/${latest.slug}/`}>Latest episode</a>
        <a class="button button-secondary" href="/episodes/">Browse all episodes</a>
      </div>
      <p class="hero-note">Since 2019 · New episodes after Giants matches · By Giants fans, for Giants fans</p>
    </div>
    <div class="logo-wrap">
      <img src="/assets/squinters-logo.png" alt="Never Surrender by The Squinters podcast artwork" width="1200" height="1200">
    </div>
  </section>

  <section class="latest-section section-space" aria-labelledby="latest-title">
    <div class="section-heading">
      <div>
        <p class="section-kicker">Fresh from the Studio</p>
        <h2 id="latest-title">Latest episode</h2>
      </div>
      <p>The latest episode of Never Surrender by The Squinters. The Big Big Sound delivered right here for your orange-flavoured listening pleasure.</p>
    </div>
    <div class="latest-grid">
      <EpisodeCard episode={latest} featured={true} />
      <div class="player-panel panel">
        <iframe src={spotifyEmbedUrl(latest.spotifyUrl)} title={`Listen to ${latest.title} on Spotify`} width="100%" height="352" frameborder="0" allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture" loading="lazy"></iframe>
      </div>
    </div>
  </section>

<section class="about panel section-space" aria-labelledby="about-title">
  <p class="section-kicker">By Giants fans, for Giants fans.</p>

  <h2 id="about-title">
    A home for the Orange Army away from the Beanstalk.
  </h2>

  	<p>Never Surrender exists because Giants supporters deserve quality content, delivered regularly and focused on the pressing issues facing the Greater Western Sydney Giants.</p>

	<p>Not just from the Club. Not from the AFL website. And definitely not from Gerard Healy. From the fans themselves.</p>

	<p>Rusted-on Squinters who drive to work squinting into the morning sun, drive home with an equally compromised view, then spend the weekend squinting from Bay 206 at the Beanstalk or from Manuka Hill at the Golden Egg while politely cheering. (We love you, Canberra fan base.)</p>

	<p>Completely biased. Orange-tinted. Occasionally unhinged. Opinions, outlooks and speculation delivered with unchecked enthusiasm and passion — just as the Orange Army expects and deserves.</p>

	<p>Since 2019, The Squinters have gathered after the siren to celebrate, commiserate, speculate and occasionally string together genuine orange pearls of wisdom and wonder.</p>

	<p>And, of course, it's all delivered free of charge — notwithstanding the generous souls who have actually donated through Buy Me a Coffee. We see you. We appreciate you. And, obviously, our growing list of sponsors, who get a shout-out each week. Thanks for all your help, Universal Music.</p>
  
  <a class="text-link" href="/about/">
    Meet the Squinters and read our brief but rich history as an emerging Goliath in the Australian sports media landscape →
  </a>
</section>

  <section class="section-space" aria-labelledby="why-title">
  <div class="section-heading">
    <div>
      <p class="section-kicker">Why listen?</p>
      <h2 id="why-title">
        There’s a Big Big Sound from the West of the Town...
      </h2>
    </div>

    <p>
      They say we were born from a focus group.<br><br>
      They say Leon was handed a Lamborghini and only had to steer it to a premiership.<br><br>
      They say it'll never work — trying to compete from deep within rugby league heartland.<br><br>
      But we're just as mad, passionate and emotionally invested as supporters of clubs backed by generations of inherited certainty. We’re building an Orange Tsunami across Greater Western Sydney and beyond — from Concord to Canberra, Ashfield to Albury, Parramatta to Parkes, and Toongabbie to Tamworth.
    </p>
  </div>

  <div class="reason-grid">
    <article class="reason-card panel">
      <span>01</span>
      <h3>Giants fans first</h3>
      <p>We are one-eyed Giants. No neutral takes. No fence-sitting. The Squinters see Orange. We bleed Charcoal.</p>
    </article>

    <article class="reason-card panel">
      <span>02</span>
      <h3>Every match unpacked</h3>
      <p>Reviews, previews, selection analysis, injury-crisis management, media-myth debunking and all the giant issues of the week, dutifully unpacked. Unauthorised. Unfiltered. Uninformed.</p>
    </article>

    <article class="reason-card panel">
      <span>03</span>
      <h3>More than just analysis</h3>
      <p>Rag’s Bakes, dubious maths, Stoic Advice with Sparrow, Hairloss Journeys with Orca, plaques to hunt down across Western Sydney, quizzes with Needles, and some of the greatest footy tribute songs since Mike Brady’s ’79 masterpiece — delivered by resident musician Ragnar Lothbrok and Western Sydney RSL circuit legends, Jimmy and the Boys.</p>
    </article>
  </div>
</section>

  <section class="section-space" aria-labelledby="hosts-title">
    <div class="section-heading">
      <div>
        <p class="section-kicker">Current operators</p>
        <h2 id="hosts-title">Four microphones. One Zoom account.</h2>
      </div>
      <p>Needles, Sparrow, Ragnar Lothbrok and Orca.</p>
    </div>
    <div class="host-grid">{hosts.map(host => <HostCard host={host} />)}</div>
  </section>

  <section class="section-space"><RatingStrip /></section>

  <section class="links-section" aria-labelledby="links-title">
    <div class="section-heading">
      <div>
        <p class="section-kicker">Everything Squinters</p>
        <h2 id="links-title">Listen. Follow. Never Surrender.</h2>
      </div>
      <p>Pick your platform.</p>
    </div>
    <SocialGrid />
  </section>

  <section class="support-panel panel section-space">
    <div>
      <p class="section-kicker">Keep the Tanami Transport Road Train moving</p>
      <h2>Support the pod.</h2>
      <p>Help cover hosting, equipment and Ragnar’s premium Zoom account — or simply buy the lads a coffee in appreciation of their uninformed opinions.</p>
    </div>
    <a class="button button-primary" href={site.supportUrl} target="_blank" rel="noopener noreferrer">Buy us a coffee ↗</a>
  </section>
</BaseLayout>
