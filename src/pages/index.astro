---
import BaseLayout from '../layouts/BaseLayout.astro';
import EpisodeCard from '../components/EpisodeCard.astro';
import HostCard from '../components/HostCard.astro';
import RatingStrip from '../components/RatingStrip.astro';
import SocialGrid from '../components/SocialGrid.astro';
import { episodes, spotifyEmbedUrl } from '../data/episodes';
import { hosts } from '../data/hosts';
import { site, socials } from '../data/site';

const latest = episodes[0];
const podcastSchema = {
  '@context': 'https://schema.org',
  '@type': 'PodcastSeries',
  name: site.name,
  url: site.url,
  description: site.description,
  image: `${site.url}/assets/squinters-logo.png`,
  sameAs: socials.filter(item => !item.internal).map(item => item.url),
  author: { '@type': 'Organization', name: 'The Squinters' }
};
---
<BaseLayout schema={podcastSchema}>
  <section class="hero home-hero" aria-labelledby="page-title">
    <div class="hero-copy">
      	<p class="eyebrow">The <s>only</s> original GWS Giants podcast by Giants fans</p>
		<h1 id="page-title">Never Surrender.<br>
		<span>By The Squinters.</span></h1>
		<p class="intro">Every week, after every Giants match, The Squinters biasedly review the game, preview the next one, speculate on the giant issues of the week and impartially discuss anything else that biasedly occurs to them.</p>
		<div class="status">
  			<span aria-hidden="true"></span> Unauthorised. Unfiltered. Uninformed.
  			</div>
      <div class="button-row">
        <a class="button button-primary" href={`/episodes/${latest.slug}/`}>Latest episode</a>
        <a class="button button-secondary" href="/episodes/">Browse all episodes</a>
      </div>
      <p class="hero-note">Since 2019 · New episodes after Giants matches · By Giants fans, for Giants fans</p>
    </div>
    <div class="logo-wrap">
      <img src="/assets/squinters-logo.png" alt="Never Surrender by The Squinters podcast artwork" width="1200" height="1200">
    </div>
  </section>

  <section class="latest-section section-space" aria-labelledby="latest-title">
    <div class="section-heading">
      <div>
        <p class="section-kicker">Fresh from the Zoom Account</p>
        <h2 id="latest-title">Latest episode</h2>
      </div>
      <p>The latest episode of Never Surrender by The Squinters. The Big Big Sound delivered right here for your orange-tinted listening pleasure.</p>
    </div>
    <div class="latest-grid">
      <EpisodeCard episode={latest} featured={true} />
      <div class="player-panel panel">
        <iframe src={spotifyEmbedUrl(latest.spotifyUrl)} title={`Listen to ${latest.title} on Spotify`} width="100%" height="352" frameborder="0" allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture" loading="lazy"></iframe>
      </div>
    </div>
  </section>

<section class="about panel section-space" aria-labelledby="about-title">
  <p class="section-kicker">By Giants fans, for Giants fans.</p>

  <h2 id="about-title">
    A home for the Orange Army away from the Beanstalk.
  </h2>

  <p>
    Never Surrender exists because Giants supporters deserve quality content, delivered regularly, focused on the pressing issues facing the Greater Western Sydney Giants. Orange-tinted opinions and outlooks, completely biased an unhinged — just as the Orange Army expects.
  </p>

  <p>
    Since 2019, The Squinters have gathered after the siren to celebrate,
    commiserate, speculate and occasionally stumble across an orange pearl
    of wisdom.
  </p>

  <a class="text-link" href="/about/">
    Meet the Squinters and read our brief but rich history as an emerging goliath in sports media  →
  </a>
</section>

  <section class="section-space" aria-labelledby="why-title">
  <div class="section-heading">
    <div>
      <p class="section-kicker">Why listen?</p>
      <h2 id="why-title">
        Because the Big Big Sound of the Orange Army needs to be heard.
      </h2>
    </div>

    <p>
      They say we were born from a focus group. That Leon was handed a
      Lamborghini and only had to steer it to a premiership. That a Giants
      fanbase could never truly grow in rugby league heartland.
      <br><br>
      But we are just as mad, passionate and emotionally invested as supporters
      of clubs backed by generations of inherited certainty. We’re building an
      Orange Tsunami across Greater Western Sydney and beyond—from Concord to
      Canberra, Parramatta to Parkes, and Toongabbie to Tocumwal.
    </p>
  </div>

  <div class="reason-grid">
    <article class="reason-card panel">
      <span>01</span>
      <h3>Giants fans first</h3>
      <p>
        No neutral theatre. No pretending the result doesn’t ruin the week.
        The pod is made inside the Orange Army.
      </p>
    </article>

    <article class="reason-card panel">
      <span>02</span>
      <h3>Every match unpacked</h3>
      <p>
        Reviews, previews, selections, injuries, media noise and the giant
        issues of the week—usually biasedly.
      </p>
    </article>

    <article class="reason-card panel">
      <span>03</span>
      <h3>More than analysis</h3>
      <p>
        Rag's Bakes, dubious maths, stoic advice, hairloss journeys, quizzes
        and songs no one formally requested.
      </p>
    </article>
  </div>
</section>

  <section class="section-space" aria-labelledby="hosts-title">
    <div class="section-heading">
      <div>
        <p class="section-kicker">Current operators</p>
        <h2 id="hosts-title">Four microphones. One shared affliction.</h2>
      </div>
      <p>Needles, Sparrow, Ragnar Lothbrok and Orca.</p>
    </div>
    <div class="host-grid">{hosts.map(host => <HostCard host={host} />)}</div>
  </section>

  <section class="section-space"><RatingStrip /></section>

  <section class="links-section" aria-labelledby="links-title">
    <div class="section-heading">
      <div>
        <p class="section-kicker">Everything Squinters</p>
        <h2 id="links-title">Listen. Follow. Never Surrender.</h2>
      </div>
      <p>Pick your platform.</p>
    </div>
    <SocialGrid />
  </section>

  <section class="support-panel panel section-space">
    <div>
      <p class="section-kicker">Keep the road train moving</p>
      <h2>Support the pod.</h2>
      <p>Help with hosting, equipment, Grand Final flights and Ragnar’s deeply questionable spreadsheet infrastructure.</p>
    </div>
    <a class="button button-primary" href={site.supportUrl} target="_blank" rel="noopener noreferrer">Buy us a coffee ↗</a>
  </section>
</BaseLayout>
