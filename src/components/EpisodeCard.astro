---
import type { Episode } from '../data/episodes';
interface Props { episode: Episode; featured?: boolean; }
const { episode, featured = false } = Astro.props;
---
<article class:list={["episode-card", featured && "episode-card-featured"]}>
  <div class="episode-meta">
    <span>Episode {episode.episodeNumber}</span>
    <span>{episode.year} · Round {episode.round}</span>
    {episode.publishedLabel && <time datetime={episode.published}>{episode.publishedLabel}</time>}
  </div>
  <h3><a href={`/episodes/${episode.slug}/`}>{episode.title}</a></h3>
  <p>{episode.summary}</p>
  <div class="card-actions">
    <a class="text-link" href={`/episodes/${episode.slug}/`}>Episode details <span aria-hidden="true">→</span></a>
    <a class="text-link muted-link" href={episode.spotifyUrl} target="_blank" rel="noopener noreferrer">Spotify ↗</a>
    <a class="text-link muted-link" href={episode.appleUrl} target="_blank" rel="noopener noreferrer">Apple ↗</a>
  </div>
</article>
